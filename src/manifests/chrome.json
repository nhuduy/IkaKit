{
  "manifest_version": 3,
  "name": "IkaKit",
  "version": "1.0.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "icons": {
    "16":  "assets/icon/16.png",
    "32":  "assets/icon/32.png",
    "48":  "assets/icon/48.png",
    "128": "assets/icon/128.png"
  },
  "action": {
    "default_icon": "assets/icon/128.png",
    "default_title": "IkaKit"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*.ikariam.gameforge.com/*",
        "https://*.ikariam.gameforge.com/*"
      ],
      "js": ["libs/browser-polyfill.min.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*.ikariam.gameforge.com/*",
        "https://*.ikariam.gameforge.com/*"
      ],
      "js": ["content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://*.ikariam.gameforge.com/*",
    "https://*.ikariam.gameforge.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "http://*.ikariam.gameforge.com/*",
        "https://*.ikariam.gameforge.com/*"
      ],
      "resources": [
        "assets/images/*",
        "assets/images/empire/*",
        "assets/images/empire/resources/*",
        "assets/icon/*",
        "content/*",
        "content/helpers/*",
        "content/modules/empire/*",
        "css/*",
        "tpl/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
