{
  "manifest_version": 3,
  "name": "IkaKit",
  "version": "1.0.1",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "ikakit@ikakit.dev",
      "strict_min_version": "112.0"
    }
  },
  "icons": {
    "16":  "assets/icon/16.png",
    "32":  "assets/icon/32.png",
    "48":  "assets/icon/48.png",
    "128": "assets/icon/128.png"
  },
  "action": {
    "default_icon": "assets/icon/128.png",
    "default_title": "IkaKit"
  },
  "background": {
    "scripts": ["background/index.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*.ikariam.gameforge.com/*",
        "https://*.ikariam.gameforge.com/*"
      ],
      "js": ["libs/browser-polyfill.min.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*.ikariam.gameforge.com/*",
        "https://*.ikariam.gameforge.com/*"
      ],
      "js": ["content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://*.ikariam.gameforge.com/*",
    "https://*.ikariam.gameforge.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "http://*.ikariam.gameforge.com/*",
        "https://*.ikariam.gameforge.com/*"
      ],
      "resources": [
        "assets/images/*",
        "assets/images/empire/*",
        "assets/images/empire/actions/*",
        "assets/images/empire/resources/*",
        "assets/icon/*",
        "content/*",
        "content/helpers/*",
        "content/modules/alerts/*",
        "content/modules/cityWatcher/*",
        "content/modules/empire/*",
        "content/modules/militaryAlerts/*",
        "content/modules/notificationAlerts/*",
        "content/modules/transport/*",
        "css/*",
        "tpl/*"
      ]
    }
  ]
}
